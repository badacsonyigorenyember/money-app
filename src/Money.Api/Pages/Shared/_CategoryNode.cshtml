@model Money.Application.Contracts.CategoryNodeDto

<li>
    <div class="tree-row">
        <span class="name">@Model.Name</span>
        <button class="btn--small"
                hx-post="@($"/categories?handler=Archive&id={Model.Id}&kind={Model.Kind}")"
                hx-target="#tree" hx-swap="outerHTML" hx-disabled-elt="this"
                hx-confirm="Archive @Model.Name? It leaves your lists, and past transactions keep it.">
            Archive
        </button>
    </div>

    @if (Model.Children.Count > 0)
    {
        <ul>
            @foreach (var child in Model.Children)
            {
                @await Html.PartialAsync("Shared/_CategoryNode", child)
            }
        </ul>
    }
</li>
