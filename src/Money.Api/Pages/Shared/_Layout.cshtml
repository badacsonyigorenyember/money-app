@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // "Where am I" is answered once, here, so no page can forget to answer it.
    var path = Context.Request.Path.Value ?? "/";
    string? Current(string href) =>
        (href == "/" ? path == "/" : path.StartsWith(href, StringComparison.OrdinalIgnoreCase))
            ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Money</title>
    @* Version-stamped: WebView2 keeps its own cache, and a stylesheet held over from the
       previous build is a broken-looking app after an update. *@
    <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
    <script src="~/lib/htmx.min.js" defer></script>
</head>
<body hx-headers='{"RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="topbar">
        <a class="brand" href="/">Money</a>
        <nav aria-label="Main">
            <a href="/transactions" aria-current="@Current("/transactions")">Home</a>
            <a href="/categories" aria-current="@Current("/categories")">Categories</a>
            <a href="/accounts" aria-current="@Current("/accounts")">Accounts</a>
            <a href="/settings" aria-current="@Current("/settings")">Settings</a>
        </nav>
    </header>

    @* The history element, so a boosted step back restores only the page body and leaves the
       dialog and the script below it - and their listeners - alone. *@
    <main id="content" hx-history-elt>
        @RenderBody()
    </main>

    @* hx-confirm asks through window.confirm, which a host is free to suppress - and when it
       is suppressed the answer is a silent "no", so the click does nothing and says nothing.
       <dialog> is the platform's own modal and always shows, so every confirmation in the app
       comes through here. *@
    <dialog id="confirm" class="confirm" aria-labelledby="confirm-question">
        <p id="confirm-question"></p>
        <div class="form-actions">
            <button type="button" id="confirm-no" autofocus>Cancel</button>
            <button type="button" id="confirm-yes" class="primary">Continue</button>
        </div>
    </dialog>

    <script>
        // The answer rides on the buttons' own clicks, not on the dialog's close event and not
        // on a method="dialog" returnValue: WebView2 does not always fire close, which would
        // strand the request the same way the suppressed window.confirm did.
        (function () {
            var dialog = document.getElementById('confirm');
            var proceed = null;

            document.getElementById('confirm-yes').addEventListener('click', function () {
                var go = proceed;
                proceed = null;
                dialog.close();
                if (go) go();
            });

            function drop() { proceed = null; dialog.close(); }
            document.getElementById('confirm-no').addEventListener('click', drop);
            dialog.addEventListener('cancel', drop);

            document.addEventListener('htmx:confirm', function (event) {
                if (!event.detail.question) return;
                event.preventDefault();

                document.getElementById('confirm-question').textContent = event.detail.question;
                proceed = function () { event.detail.issueRequest(true); };
                dialog.showModal();
            });
        })();

        // Anything else that sticks has to start below the sticky bar at the top, and that bar
        // wraps to two rows on a narrow window - so its height is measured here rather than
        // guessed in the stylesheet. ResizeObserver fires once on observe, which is the initial
        // value.
        (function () {
            var topbar = document.querySelector('.topbar');
            new ResizeObserver(function () {
                document.documentElement.style.setProperty('--topbar-h', topbar.offsetHeight + 'px');
            }).observe(topbar);
        })();

        // Stepping between months replaces the whole of <main>, so the document is briefly empty
        // and the browser clamps the scroll position to the top of what is left. Putting it back
        // leaves the reader looking at the same part of the page. The list is never given a
        // height of its own - it stays exactly as tall as the month is busy - so on a month short
        // enough to make the whole page shorter than the old position, the browser wins and the
        // reader lands at the new bottom. That is the one case the two cannot both be had.
        (function () {
            var y = 0;

            function ours(event) {
                var target = (event.detail && event.detail.target) || event.target;
                return !!target && target.id === 'content';
            }

            function restore() { if (window.scrollY !== y) window.scrollTo(0, y); }

            document.body.addEventListener('htmx:beforeSwap', function (event) {
                if (ours(event)) y = window.scrollY;
            });

            // Both, not just the settle: htmx leaves ~20ms between them, long enough for a swap
            // back to the top to be seen.
            document.body.addEventListener('htmx:afterSwap', function (event) {
                if (ours(event)) restore();
            });

            document.body.addEventListener('htmx:afterSettle', function (event) {
                if (ours(event)) restore();
            });
        })();
    </script>
</body>
</html>
