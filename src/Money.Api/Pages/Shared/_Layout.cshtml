@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // "Where am I" is answered once, here, so no page can forget to answer it.
    var path = Context.Request.Path.Value ?? "/";
    string? Current(string href) =>
        (href == "/" ? path == "/" : path.StartsWith(href, StringComparison.OrdinalIgnoreCase))
            ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Money</title>
    <link rel="stylesheet" href="~/app.css" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <script src="~/lib/htmx.min.js" defer></script>
</head>
<body hx-headers='{"RequestVerificationToken": "@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="topbar">
        <a class="brand" href="/">Money</a>
        <nav aria-label="Main">
            <a href="/transactions" aria-current="@Current("/transactions")">Home</a>
            <a href="/categories" aria-current="@Current("/categories")">Categories</a>
            <a href="/accounts" aria-current="@Current("/accounts")">Accounts</a>
            <a href="/settings" aria-current="@Current("/settings")">Settings</a>
        </nav>
    </header>

    <main id="content">
        @RenderBody()
    </main>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(function () { });
        }
    </script>
</body>
</html>
