@model Money.Api.Pages.TransactionsModel
@using Money.Application.Presentation
@{
    // A heading is the control that orders by it, and it is a plain link: the order ends up in
    // the address, so the back button walks it and a reload keeps it. Boosting it swaps <main>
    // in place, exactly as the month arrows above do.
    async Task Column(string key, string label, string? extraClass)
    {
        await Task.CompletedTask;

        var href = Url.Page("/Transactions", new
        {
            month = Model.Overview.PeriodKey, q = Model.Q,
            includeVoided = Model.IncludeVoided, sort = Model.NextSort(key)
        });

        <th scope="col" class="@extraClass" aria-sort="@Model.AriaSort(key)">
            <a class="sort" href="@href">@label</a>
        </th>
    }
}

<div id="rows">
    @if (Model.ErrorMessage is not null)
    {
        <p class="notice notice--error" role="alert">@Model.ErrorMessage</p>
    }

    @if (Model.RepeatMessage is not null)
    {
        <p class="notice notice--ok" role="status">@Model.RepeatMessage</p>
    }

    @if (Model.Page.Items.Count == 0)
    {
        @* Reached by stepping back through the months as often as on a first run, so it says
           which month is empty and points at the way out rather than assuming a beginner. *@
        <div class="empty">
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <strong>Nothing matching &ldquo;@Model.Q&rdquo; in @Model.Overview.Label</strong>
                <p>Clear the search, or step to another month with the arrows above.</p>
            }
            else
            {
                <strong>Nothing in @Model.Overview.Label</strong>
                <p>Step to another month with the arrows above, or record something with +.</p>
            }
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead hx-boost="true" hx-target="#content" hx-select="#content" hx-swap="outerHTML show:none">
                    <tr>
                        @{ await Column("date", "Date", null); }
                        @{ await Column("description", "Description", null); }
                        @{ await Column("category", "Category", "hide-narrow"); }
                        @{ await Column("account", "Account", "hide-narrow"); }
                        @{ await Column("amount", "Amount", "amount"); }
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Page.Items)
                {
                    <tr class="@(item.IsVoided ? "voided" : null)">
                        <td class="date">@item.OccurredOn.ToString("yyyy-MM-dd")</td>
                        <td class="primary-cell">
                            @item.Description
                            <span class="sub">
                                @string.Join(" · ", new[] { item.CategoryName, item.AccountName }
                                    .Where(part => !string.IsNullOrWhiteSpace(part)))
                            </span>
                        </td>
                        <td class="hide-narrow">@item.CategoryName</td>
                        <td class="hide-narrow">@item.AccountName</td>
                        <td class="amount">
                            @CurrencyFormat.Format(item.Amount, item.CurrencyCode)<span class="ccy">@item.CurrencyCode</span>
                        </td>
                        <td class="actions">
                            @if (!item.IsVoided)
                            {
                                <button class="btn--small btn--danger"
                                        hx-post="@($"/transactions?handler=Void&month={Model.Overview.PeriodKey}&sort={Model.CurrentSort}&id={item.Id}&reason=Removed+by+the+user")"
                                        hx-target="#rows" hx-swap="outerHTML" hx-disabled-elt="this"
                                        hx-confirm="Remove this transaction? It stays in your history, marked as removed.">
                                    Remove
                                </button>
                            }
                            else
                            {
                                <span class="badge">Removed</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.RulesOutOfBand)
{
    @* The repeating-rules list and the chart live in their own sections further up the page, so
       they ride along on this response as out-of-band swaps rather than needing more requests.
       Without the chart here, recording a spend would leave the line above it unmoved. *@
    <div id="recurring-list" hx-swap-oob="true">
        <partial name="Shared/_RecurringRules" model="Model" />
    </div>

    @if (Model.Overview.Accounts.Count > 0)
    {
        <div hx-swap-oob="outerHTML:#monthChart">
            <partial name="Shared/_AccountOverview" model="Model" />
        </div>
    }
}
