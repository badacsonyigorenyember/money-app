@model Money.Api.Pages.CategoriesModel
@using Money.Application.Presentation

@functions {
    static string Entries(int count) => count == 1 ? "1 entry" : $"{count} entries";
}

<div id="tree">
    @if (Model.ErrorMessage is not null)
    {
        <p class="notice notice--error" role="alert">@Model.ErrorMessage</p>
    }

    @if (Model.Message is not null)
    {
        <p class="notice notice--ok" role="status">@Model.Message</p>
    }

    <section class="section">
        <h2>Your @Model.KindLabel categories</h2>

        @if (Model.Nodes.Count == 0)
        {
            <div class="empty">
                <strong>No categories yet</strong>
                <p>Add one above, then start filing transactions under it.</p>
            </div>
        }
        else
        {
            <div class="card">
                <ul class="tree">
                    @foreach (var node in Model.Nodes)
                    {
                        @await Html.PartialAsync("Shared/_CategoryNode", node)
                    }
                </ul>
            </div>
        }
    </section>

    @if (Model.Archived.Count > 0)
    {
        <section class="section">
            <h2>
                Archived
                <small>
                    Out of your lists, history intact. Deleting is permanent — there is no undo,
                    and everything filed underneath goes with it.
                </small>
            </h2>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Category</th>
                            <th scope="col">In your history</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Archived)
                    {
                        var confirm = row.Entries == 0
                            ? $"Delete {row.Category.Name} for good? Nothing in your history uses it, so it will be erased completely. This cannot be undone."
                            : $"Delete {row.Category.Name} for good? Your existing {Entries(row.Entries)} stays where it is, and will name it \"{row.Category.Name}{AccountDisplayName.DeletedSuffix}\". This cannot be undone.";

                        <tr>
                            <td class="primary-cell">@row.Category.Name</td>
                            <td>
                                @if (row.Entries == 0)
                                {
                                    <span class="badge badge--safe">Nothing uses it</span>
                                }
                                else
                                {
                                    <span class="badge badge--kept">@Entries(row.Entries)</span>
                                }
                            </td>
                            <td class="actions">
                                <button class="btn--small"
                                        hx-post="@($"/categories?handler=Restore&id={row.Category.Id}&kind={Model.Kind}")"
                                        hx-target="#tree" hx-swap="outerHTML" hx-disabled-elt="this">
                                    Restore
                                </button>
                                <button class="btn--small btn--danger"
                                        hx-post="@($"/categories?handler=Delete&id={row.Category.Id}&kind={Model.Kind}")"
                                        hx-target="#tree" hx-swap="outerHTML" hx-disabled-elt="this"
                                        hx-confirm="@confirm">
                                    Delete for good
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
