@page
@model SettingsModel
@using System.Globalization
@{
    ViewData["Title"] = "Settings";
    var zones = SettingsModel.TimeZoneIds.Contains(Model.Form.TimeZoneId, StringComparer.Ordinal)
        ? SettingsModel.TimeZoneIds
        : SettingsModel.TimeZoneIds.Prepend(Model.Form.TimeZoneId).ToArray();
}

<div class="page-head">
    <h1>Settings</h1>
    <p>How this app counts your months and weeks, and what it does with your data.</p>
</div>

@if (Model.Message is not null) { <p class="notice notice--ok" role="status">@Model.Message</p> }
@if (Model.ErrorMessage is not null) { <p class="notice notice--error" role="alert">@Model.ErrorMessage</p> }

<form method="post" asp-page-handler="Save" class="stack">

    <section class="section" style="margin-top:0">
        <h2>Money</h2>

        <div class="card">
            <div class="field-grid">
                <div class="field">
                    <label asp-for="Form.BaseCurrencyCode">Currency</label>
                    <select asp-for="Form.BaseCurrencyCode">
                        @foreach (var code in SettingsModel.CurrencyCodes)
                        {
                            <option value="@code">@code</option>
                        }
                    </select>
                    <span class="hint">
                        What you are shown in. New accounts start here, and an account kept in
                        another currency is converted to this one on the chart, at the day's rate.
                    </span>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <h2>
            When does your month start?
            <small>This is the day your budgets and monthly totals roll over.</small>
        </h2>

        <fieldset class="card" style="border:1px solid var(--line); margin:0">
            <legend class="visually-hidden">When does your month start?</legend>

            <div class="choice-list">
                <label class="choice">
                    <input type="radio" asp-for="Form.PeriodAnchor" value="CalendarMonth" />
                    <span class="choice-title">On the 1st of the month</span>
                    <span class="choice-note">
                        The ordinary calendar month. September runs 1 September to 30 September.
                    </span>
                </label>

                <label class="choice">
                    <input type="radio" asp-for="Form.PeriodAnchor" value="FirstMonday" />
                    <span class="choice-title">On the first Monday of the month</span>
                    <span class="choice-note">
                        The month turns over on a Monday, so weeks never straddle two months.
                    </span>
                </label>

                <label class="choice">
                    <input type="radio" asp-for="Form.PeriodAnchor" value="DayOfMonth" />
                    <span class="choice-title">On the day I get paid</span>
                    <span class="choice-note">
                        Pick the day of the month your salary lands. Your month then runs payday to
                        payday, which is how a budget is actually spent.
                    </span>
                    <span class="choice-extra field">
                        <label asp-for="Form.PeriodAnchorDay">Payday</label>
                        <input type="number" asp-for="Form.PeriodAnchorDay" min="1" max="28" />
                        <span class="hint">1 to 28 — not every month has a 29th.</span>
                    </span>
                </label>
            </div>
        </fieldset>
    </section>

    <section class="section">
        <h2>Weeks and time</h2>

        <div class="card">
            <div class="field-grid">
                <div class="field">
                    <label asp-for="Form.FirstDayOfWeek">Week starts on</label>
                    <select asp-for="Form.FirstDayOfWeek">
                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>
                        <option value="Sunday">Sunday</option>
                    </select>
                </div>

                <div class="field span-2">
                    <label asp-for="Form.TimeZoneId">Time zone</label>
                    <select asp-for="Form.TimeZoneId">
                        @foreach (var zone in zones)
                        {
                            <option value="@zone">@zone</option>
                        }
                    </select>
                    <span class="hint">Decides what counts as "today" for a late-evening spend.</span>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <h2>Backups</h2>

        <div class="card">
            <div class="field-grid">
                <div class="field">
                    <label asp-for="Form.BackupRetentionCount">Backups to keep</label>
                    <input type="number" asp-for="Form.BackupRetentionCount" min="1" max="100" />
                    <span class="hint">Older ones are removed once there are more than this.</span>
                </div>
            </div>
        </div>
    </section>

    <div class="form-actions" style="margin-top:1.5rem">
        <button class="primary" type="submit">Save settings</button>
    </div>
</form>

<section class="section">
    <h2>
        Back up now
        <small>Backups are written next to your data, in your user folder.</small>
    </h2>

    <form class="card card--sunk" method="post" asp-page-handler="Backup">
        <button type="submit">Back up now</button>
    </form>
</section>

<section class="section">
    <h2>
        Restore from a backup
        <small>Puts your data back the way it was when that backup was taken.</small>
    </h2>

    <div class="card card--sunk">
        <p class="notice notice--error" role="note" style="margin-bottom:1rem">
            Restoring <strong>replaces everything you have now</strong> with what was in the
            backup you pick — anything recorded since then is gone from the app. A backup of
            your current data is taken first, and it appears in this list, so a restore you did
            not mean can itself be undone. The app closes to finish the job; open it again
            afterwards.
        </p>

        @if (Model.Backups.Count == 0)
        {
            <p class="empty">
                <strong>No backups yet</strong>
                <span>Use "Back up now" above, and the backup will show up here.</span>
            </p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Backup</th>
                            <th scope="col">Taken</th>
                            <th scope="col" class="amount">Size</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Backups)
                    {
                        var taken = item.CreatedAtUtc.ToLocalTime()
                            .ToString("d MMMM yyyy, HH:mm", CultureInfo.CurrentCulture);
                        <tr>
                            <td class="primary-cell">@item.FileName</td>
                            <td>@taken</td>
                            <td class="amount">@((item.SizeBytes + 1023) / 1024) KB</td>
                            <td class="actions">
                                <form method="post" asp-page-handler="Restore"
                                      data-confirm="Restore from the backup taken @taken? Everything you have recorded since then will be gone from the app, and it will close so the restore can finish.">
                                    <input type="hidden" name="fileName" value="@item.FileName" />
                                    <button class="btn--small btn--danger" type="submit">Restore this one</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@* This page posts plain forms, so there is no htmx request to hook hx-confirm onto. The app has
   exactly one confirmation dialog (see _Layout) and it listens for htmx:confirm, so raise that
   event by hand rather than growing a second dialog that would have to be kept in step. *@
<script>
    document.querySelectorAll('form[data-confirm]').forEach(function (form) {
        form.addEventListener('submit', function (event) {
            event.preventDefault();
            document.dispatchEvent(new CustomEvent('htmx:confirm', {
                cancelable: true,
                detail: {
                    question: form.dataset.confirm,
                    // form.submit() does not fire submit, so this cannot loop back through here.
                    issueRequest: function () { form.submit(); }
                }
            }));
        });
    });
</script>

<section class="section">
    <h2>
        Export
        <small>Amounts are exported in whole cents so a spreadsheet cannot round them.</small>
    </h2>

    <div class="card card--sunk inline-links">
        <a class="btn" href="/settings?handler=Export&amp;format=json">Download JSON</a>
        <a class="btn" href="/settings?handler=Export&amp;format=csv">Download CSV</a>
    </div>
</section>

<section class="section">
    <h2>
        Check my data
        <small>Confirms every transaction still balances and nothing points at a missing account.</small>
    </h2>

    <form class="card card--sunk" method="post" asp-page-handler="IntegrityCheck">
        <button type="submit">Run the check</button>

        @if (Model.Report is not null)
        {
            @if (Model.Report.IsHealthy)
            {
                <p class="notice notice--ok" role="status" style="margin:1rem 0 0">Everything checks out.</p>
            }
            else
            {
                <div class="notice notice--error" role="alert" style="margin:1rem 0 0">
                    <strong>Some entries need attention:</strong>
                    <ul>
                        @foreach (var finding in Model.Report.Findings)
                        {
                            <li>@finding</li>
                        }
                    </ul>
                </div>
            }
        }
    </form>
</section>
