@page
@model CategoriesModel
@{ ViewData["Title"] = "Categories"; }

<div class="page-head">
    <h1>Categories</h1>
    <p>What your money is for. Every transaction is filed under one of these.</p>
</div>

@* Which half you are adding to is the same choice as which half you are looking at, so it is one
   control rather than two. Links, not a form: no script to switch, and the back button walks it. *@
<nav class="segmented" aria-label="Which categories">
    <a href="@Url.Page("/Categories", new { kind = "Expense" })"
       aria-current="@(Model.Kind == "Income" ? null : "true")">Spending</a>
    <a href="@Url.Page("/Categories", new { kind = "Income" })"
       aria-current="@(Model.Kind == "Income" ? "true" : null)">Income</a>
</nav>

<section class="section" style="margin-top:1.5rem">
    <h2>Add @(Model.Kind == "Income" ? "an" : "a") @Model.KindLabel category</h2>

    <form class="card" hx-post="@($"/categories?handler=Create&kind={Model.Kind}")"
          hx-target="#tree" hx-swap="outerHTML" hx-disabled-elt="find button"
          hx-on::after-request="if(event.detail.successful) this.reset()">
        <div class="field-grid">
            <div class="field">
                <label for="c-name">Name</label>
                <input id="c-name" type="text" name="name" placeholder="Groceries" required />
            </div>

            <div class="field">
                <label for="c-parent">Sits under</label>
                <select id="c-parent" name="parentCategoryId">
                    <option value="">Nothing — it is top level</option>
                    @foreach (var node in Model.Nodes)
                    {
                        <option value="@node.Id">@node.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button class="primary" type="submit">Add category</button>
        </div>
    </form>
</section>

<partial name="Shared/_CategoryTree" model="Model" />
